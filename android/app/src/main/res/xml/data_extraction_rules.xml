<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup/transfer is disabled: all durable state lives in Supabase and is
  restored on sign-in. Excluding everything keeps stale auth tokens and cached
  app data from being copied between devices.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>